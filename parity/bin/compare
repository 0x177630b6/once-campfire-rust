#!/usr/bin/env bash
# Compare two servers state by state across the support matrix, inside the pinned Playwright image.
#
#   parity/bin/compare --expected http://127.0.0.1:3100 --actual http://127.0.0.1:3200 [OPTIONS]
#   parity/bin/compare --recompare DIR [--expected-name A --actual-name B] [OPTIONS]
#   parity/bin/compare --self-parity [--runs 2] [--ports 4101,4102] [OPTIONS]
#
# --self-parity is the Phase 0 gate: for each seed the selected states use (or --seed NAME), it
# starts two fresh reference instances (parity/bin/reference) at that seed's clock, compares them,
# repeats that --runs times, and finally compares the first run's captures with the last run's.
# Any difference fails; parity/allowlist.yml is ignored. --reference-env KEY=VALUE (repeatable) is
# passed to `parity/bin/reference up` as -e.
#
# OPTIONS are those of parity/bin/capture, plus --out DIR, --allowlist FILE | --no-allowlist and
# --report NAME. Exit status is 1 if any cell fails or errors. The report is DIR/report.html.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../capture/sandbox/run.sh"

seed_given="" mode=compare runs=2 ports=4101,4102 seed=default time="" out="" recompare="" reset_host=""
args=() ref_env=()
while [ $# -gt 0 ]; do
  case "$1" in
    --self-parity) mode=self-parity; shift ;;
    --recompare)   mode=recompare; recompare=$2; shift 2 ;;
    --runs)        runs=$2; shift 2 ;;
    --ports)       ports=$2; shift 2 ;;
    --seed)        seed=$2; seed_given=1; args+=(--seed "$2"); shift 2 ;;
    --time)        time=$2; shift 2 ;;
    --out)         out=$2; shift 2 ;;
    --reset-host)  reset_host=$2; shift 2 ;;
    --reference-env) ref_env+=(-e "$2"); shift 2 ;;
    *)             args+=("$1"); shift ;;
  esac
done

mkdir -p "$PARITY/out"
REFERENCE=$PARITY/bin/reference
UP_PORTS=()
cleanup() {
  parity_cleanup
  for port in "${UP_PORTS[@]}"; do "$REFERENCE" down --port "$port" >/dev/null 2>&1 || true; done
}
trap cleanup EXIT INT TERM

seed_time() {
  local labels=$PARITY/.seed/$seed/labels.json
  [ -f "$labels" ] || die "no seed $seed at $labels; run parity/bin/seed $seed"
  node -e 'const l=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")); console.log(l["clock.now"] ?? l.clock?.now ?? "")' "$labels"
}

case "$mode" in
  compare)
    [ -n "$time" ] && args+=(--time "$time")
    [ -n "$out" ] && args+=(--out "$out")
    if [ -n "$reset_host" ]; then start_reset_loop "$reset_host"; args+=(--reset "$RESET_ARG"); fi
    run_in_image compare "${args[@]}"
    ;;

  recompare)
    [ -n "$time" ] && args+=(--time "$time")
    run_in_image recompare --out "$recompare" "${args[@]}"
    ;;

  self-parity)
    root=${out:-$PARITY/out/self-parity-$(date -u +%Y%m%dT%H%M%SZ)}
    IFS=, read -r port_a port_b <<<"$ports"
    if [ -z "$seed_given" ]; then
      seeds=$(run_in_image seeds "${args[@]}")          # every seed the selected states need
    else
      seeds=$seed
    fi
    # Drop --seed from the pass-through; each seed gets its own instances below.
    pass=() skip=""
    for a in "${args[@]}"; do
      if [ -n "$skip" ]; then skip=""; continue; fi
      if [ "$a" = --seed ]; then skip=1; continue; fi
      pass+=("$a")
    done
    failed=()
    for seed in $seeds; do
      seed_clock=${time:-$(seed_time)}
      [ -n "$seed_clock" ] || die "seed $seed records no clock.now; pass --time"
      out=$root/$seed
      # The servers' clocks start at the seed's instant and tick (a frozen libfaketime clock spins
      # Puma); the browsers' clocks are frozen at that instant with page.clock.
      up() { "$REFERENCE" up --seed "$seed" --port "$1" --time "$seed_clock" "${ref_env[@]}" >/dev/null; }
      # A mutating state gets a fresh instance per capture, with its clock frozen: the records it
      # writes carry the server's time (message timestamps, avatar ?v= cache busters), which a
      # ticking clock makes differ by the second between the two servers.
      start_reset_loop "'$REFERENCE' down --port {port} >/dev/null && '$REFERENCE' up --seed '$seed' --port {port} --time '$seed_clock' --freeze ${ref_env[*]} >/dev/null"
      for i in $(seq 1 "$runs"); do
        echo "self-parity [$seed] run $i/$runs: reference :$port_a vs reference :$port_b (clock $seed_clock)"
        UP_PORTS=("$port_a" "$port_b")
        up "$port_a" & pid_a=$!
        up "$port_b" & pid_b=$!
        wait "$pid_a" && wait "$pid_b" || die "reference instances did not come up"
        run_in_image compare --seed "$seed" --expected "http://127.0.0.1:$port_a" --actual "http://127.0.0.1:$port_b" \
          --expected-name "run-$i/expected" --actual-name "run-$i/actual" --out "$out" --time "$seed_clock" \
          --no-allowlist --report "report-run-$i" --reset "$RESET_ARG" "${pass[@]}" || failed+=("$seed run $i")
        for port in "$port_a" "$port_b"; do "$REFERENCE" down --port "$port" >/dev/null; done
        UP_PORTS=()
      done
      stop_reset_loop
      if [ "$runs" -gt 1 ]; then
        echo "self-parity [$seed] across runs: run 1 vs run $runs"
        run_in_image recompare --seed "$seed" --out "$out" --expected-name run-1/expected --actual-name "run-$runs/expected" \
          --time "$seed_clock" --no-allowlist --report report-across-runs "${pass[@]}" || failed+=("$seed across runs")
      fi
    done
    echo "reports: $root/<seed>/report-*.html"
    if [ ${#failed[@]} -gt 0 ]; then echo "SELF-PARITY FAILED: ${failed[*]}"; exit 1; fi
    echo "SELF-PARITY PASSED: zero diffs"
    ;;
esac
